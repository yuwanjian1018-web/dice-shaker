<view class="page-shell">
  <button class="settings-button icon-button {{isBusy ? 'is-busy' : ''}}" bindtap="handleOpenSettings" disabled="{{isBusy}}" hover-class="control--pressed" aria-label="设置骰子个数"><image class="icon-image" src="/assets/icons/gear-light.png" aria-hidden="true"></image></button>
  <view class="stage" bindtouchstart="handleTouchStart" bindtouchend="handleTouchEnd" bindtouchcancel="handleTouchCancel">
    <view class="table">
      <image class="tray-art" src="/assets/tray-black.png" mode="aspectFit" aria-hidden="true"></image>
      <view class="dice-tray {{isLidOpen ? 'dice-tray--visible' : ''}}" aria-hidden="{{!isLidOpen}}">
        <image wx:for="{{dice}}" wx:key="id" wx:for-item="die" class="die" style="{{die.position}}" src="{{die.image}}" mode="aspectFit" aria-label="{{isLidOpen ? '第' + (index + 1) + '颗骰子，顶面' + die.value + '点' : ''}}"></image>
      </view>
      <button class="cup-toggle cup-toggle--{{phase}}" bindtap="handleCupTap" disabled="{{isBusy}}" hover-class="none" aria-label="{{isBusy ? '正在摇动，请稍候' : lidActionLabel}}"><image class="cup-art" src="/assets/cup-black.png" mode="aspectFit" aria-hidden="true"></image></button>
    </view>
  </view>
  <button class="gesture-hint" bindtap="handleToggleLid" disabled="{{isBusy}}" hover-class="control--pressed" aria-label="{{lidActionLabel}}">
    <image class="gesture-icon" src="{{isLidOpen ? '/assets/icons/caret-double-down-light.png' : '/assets/icons/caret-double-up-light.png'}}" aria-hidden="true"></image>
    <text>{{isBusy ? (phase === 'opening' ? '揭盖中…' : (phase === 'closing' ? '合盖中…' : '摇动中…')) : (isLidOpen ? '下划合盖' : '上划揭盖')}}</text>
  </button>
  <view class="actions">
    <button class="roll-button {{isLocked ? 'roll-button--locked' : ''}} {{isBusy ? 'is-busy' : ''}}" bindtap="handleRoll" disabled="{{isBusy || isLocked}}" hover-class="control--pressed">{{isLocked ? '已锁定' : actionLabel}}</button>
    <button class="lock-button icon-button {{isLocked ? 'lock-button--locked' : ''}}" bindtap="handleToggleLock" hover-class="control--pressed" aria-label="{{isLocked ? '已锁定，点击解锁后可摇骰子' : '未锁定，点击锁定摇骰子'}}"><image class="lock-image" src="{{isLocked ? '/assets/icons/lock-light.png' : '/assets/icons/lock-open-light.png'}}" aria-hidden="true"></image></button>
    <text class="action-note" aria-live="polite">{{isLocked ? '点右侧锁解锁' : (soundError ? '音效暂不可用，请检查设备声音' : '')}}</text>
  </view>
  <view wx:if="{{settingsOpen}}" class="settings-overlay" catchtouchmove="preventMove">
    <view class="settings-scrim" bindtap="handleCloseSettings"></view>
    <view class="settings-sheet" role="dialog" aria-modal="true" aria-label="设置">
      <view class="sheet-handle"></view>
      <view class="sheet-heading"><text>设置</text><button class="close-button" bindtap="handleCloseSettings" hover-class="control--pressed" aria-label="关闭设置，不保存改动"><image class="close-icon" src="/assets/icons/x-light.png" aria-hidden="true"></image></button></view>
      <text class="count-label">骰子个数</text>
      <view class="count-stepper">
        <button class="stepper-button {{draftDiceCount === 1 || isLocked ? 'is-disabled' : ''}}" bindtap="handleDecreaseCount" disabled="{{draftDiceCount === 1 || isLocked}}" hover-class="control--pressed" aria-label="减少一颗骰子"><image class="stepper-icon" src="/assets/icons/minus-light.png" aria-hidden="true"></image></button>
        <text class="count-value" aria-live="polite">{{draftDiceCount}}</text>
        <button class="stepper-button {{draftDiceCount === 6 || isLocked ? 'is-disabled' : ''}}" bindtap="handleIncreaseCount" disabled="{{draftDiceCount === 6 || isLocked}}" hover-class="control--pressed" aria-label="增加一颗骰子"><image class="stepper-icon" src="/assets/icons/plus-light.png" aria-hidden="true"></image></button>
      </view>
      <text class="count-range">{{isLocked ? '请先解锁，再调整个数' : '1–6 颗'}}</text>
      <button class="done-button" bindtap="handleSaveSettings" hover-class="control--pressed">完成</button>
    </view>
  </view>
</view>
