<view class="page-shell">
  <view class="content">
    <view class="hero">
      <text class="eyebrow">日常里的小小玩心</text>
      <text class="title">摇一点小好运</text>
      <text class="subtitle">轻轻摇一摇，惊喜自己揭晓</text>
    </view>

    <view class="play-card">
      <view class="card-topline">
        <text class="lid-status lid-status--{{phase}}">{{lidStateLabel}}</text>
        <text class="dice-count">五颗骰子 · 一点惊喜</text>
      </view>

      <view class="stage">
        <image class="tray-art" src="/assets/tray-sage.png" mode="aspectFit" aria-hidden="true"></image>

        <view class="dice-tray {{isLidOpen ? 'dice-tray--visible' : ''}}" aria-hidden="{{!isLidOpen}}">
          <view
            wx:for="{{dice}}"
            wx:key="id"
            wx:for-item="die"
            class="die die--{{index}} die--{{die.color}} die--value-{{die.value}}"
            aria-label="{{isLidOpen ? '第' + (index + 1) + '颗骰子，' + die.value + '点' : ''}}"
          >
            <view
              wx:for="{{die.pips}}"
              wx:key="key"
              wx:for-item="pip"
              class="pip pip--{{pip.key}} {{pip.visible ? 'pip--visible' : ''}}"
            ></view>
          </view>
        </view>

        <button
          class="cup-toggle cup-toggle--{{phase}} {{isBusy ? 'is-busy' : ''}}"
          hover-class="cup-toggle--pressed"
          disabled="{{isBusy}}"
          bindtap="handleToggleLid"
          aria-label="{{isBusy ? '骰盅正在动作，请稍候' : lidActionLabel}}"
        >
          <image class="cup-art" src="/assets/cup-mint.png" mode="aspectFit" aria-hidden="true"></image>
        </button>
      </view>

      <view class="status-copy" aria-live="polite">
        <text class="status-text">{{statusText}}</text>
      </view>

      <view class="actions">
        <button
          class="roll-button {{isBusy ? 'is-busy' : ''}}"
          hover-class="action--pressed"
          disabled="{{isBusy}}"
          bindtap="handleRoll"
        >
          <image class="action-icon" src="/assets/icons/dice-five-white.png" aria-hidden="true"></image>
          <text>{{actionLabel}}</text>
        </button>
        <button
          class="lid-button {{isBusy ? 'is-busy' : ''}}"
          hover-class="action--pressed"
          disabled="{{isBusy}}"
          bindtap="handleToggleLid"
        >
          <image class="lid-icon" src="{{isLidOpen ? '/assets/icons/arrow-down.png' : '/assets/icons/arrow-up.png'}}" aria-hidden="true"></image>
          <text>{{lidActionLabel}}</text>
        </button>
      </view>

      <view class="tap-hint">
        <image class="tap-icon" src="/assets/icons/hand-tap.png" aria-hidden="true"></image>
        <text>轻点骰盅，也能开合</text>
      </view>
    </view>

    <view class="page-note">
      <text>不必急着揭晓</text>
      <text class="page-note-detail">把小小的期待，多留一会儿</text>
    </view>
  </view>
</view>
